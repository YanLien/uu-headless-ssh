+//! A terminal created for one command belongs to that command. Keep cleanup
+//! outside its cancellable I/O future so signaling errors cannot skip deletion.
+use super::terminal::Terminal;
+use serde_json::Value;
+use std::{
+    collections::HashSet,
+    sync::{Arc, Mutex},
+};
+
+#[derive(Clone, Default)]
+pub struct Cleanup(Arc<Mutex<Option<Tracked>>>);
+
+struct Tracked {
+    terminal: Arc<Terminal>,
+
+    /// Session ids observed before OPEN; they can never become owned here.
+    before: HashSet<u32>,
+
+    /// Explicit attachment, or an OPEN reply that reused a preexisting id.
+    existing: bool,
+
+    /// Wire id can be zero on Windows, even though LIST exposes a stable id.
+    wire: Option<u32>,
+
+    /// Stable LIST id confirmed to have been created by this invocation.
+    owned: Option<u32>,
+}
+
+fn ids(rows: &[Value]) -> HashSet<u32> {
+    rows.iter()
+        .filter_map(|row| {
+            row["session_id"]
+                .as_u64()
+                .and_then(|id| u32::try_from(id).ok())
+                .filter(|id| *id != 0)
+        })
+        .collect()
+}
+
+impl Cleanup {
+    /// Register the pre-OPEN inventory and retain the worker across cancellation.
+    pub fn track(&self, terminal: Arc<Terminal>, existing: bool, before: &[Value]) {
+        *self.0.lock().unwrap() = Some(Tracked {
+            terminal,
+            before: ids(before),
+            existing,
+            wire: None,
+            owned: None,
+        });
+    }
+
+    /// Record a successful OPEN acknowledgement before any further await.
+    pub fn opened(&self, id: u32) {
+        if let Some(tracked) = self.0.lock().unwrap().as_mut() {
+            tracked.wire = Some(id);
+            if !tracked.existing && id != 0 {
+                if tracked.before.contains(&id) {
+                    tracked.existing = true;
+                } else {
+                    tracked.owned = Some(id);
+                }
+            }
+        }
+    }
+
+    /// Return only a confirmed owned id for cleanup over a fresh management peer.
+    pub fn owned(&self) -> Option<u32> {
+        self.0
+            .lock()
+            .unwrap()
+            .as_ref()
+            .and_then(|tracked| tracked.owned)
+    }
+
+    /// Forget ownership only after cleanup succeeded or was explicitly resolved.
+    pub fn complete(&self) {
+        self.0.lock().unwrap().take();
+    }
+
+    /// Windows OPEN may acknowledge only success, with wire id zero. Compare
+    /// inventories immediately, before accepting user input; ambiguity is an
+    /// error rather than permission to terminate someone else's session.
+    pub async fn identify(&self) -> Result<(), String> {
+        let (terminal, before) = {
+            let guard = self.0.lock().unwrap();
+            let Some(tracked) = guard.as_ref() else {
+                return Ok(());
+            };
+            if tracked.existing || tracked.owned.is_some() || tracked.wire.is_none() {
+                return Ok(());
+            }
+            (tracked.terminal.clone(), tracked.before.clone())
+        };
+        let after = ids(&terminal.list_sessions().await?);
+        let created: Vec<_> = after.difference(&before).copied().collect();
+        if created.len() > 1 {
+            return Err("Cannot identify the newly created terminal safely".into());
+        }
+        if let Some(tracked) = self.0.lock().unwrap().as_mut() {
+            tracked.owned = created.first().copied();
+            if created.is_empty() {
+                tracked.existing = true;
+            }
+        }
+        Ok(())
+    }
+
+    /// Explicitly attached sessions are detached. New sessions are removed with
+    /// KILL, while an already-exited shell needs no further action.
+    pub async fn finish(&self) -> Result<(), String> {
+        self.identify().await?;
+        let snapshot = self.0.lock().unwrap().as_ref().map(|tracked| {
+            (
+                tracked.terminal.clone(),
+                tracked.existing,
+                tracked.wire,
+                tracked.owned,
+            )
+        });
+        let Some((terminal, existing, wire, owned)) = snapshot else {
+            return Ok(());
+        };
+        if !existing && wire.is_none() {
+            return Err("Terminal open was interrupted before ownership was confirmed".into());
+        }
+        if existing {
+            if let Some(id) = wire {
+                terminal.detach(id).await?;
+            }
+        } else if let Some(id) = owned {
+            if ids(&terminal.list_sessions().await?).contains(&id) {
+                if let Err(error) = terminal.kill(id).await {
+                    if ids(&terminal.list_sessions().await?).contains(&id) {
+                        return Err(error);
+                    }
+                }
+            }
+        }
+        self.complete();
+        Ok(())
+    }
+}
