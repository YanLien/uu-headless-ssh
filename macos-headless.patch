+            ws.send(Message::Text("0{}".into())).await.unwrap();
+            assert_eq!(ws.next().await.unwrap().unwrap(),Message::Text("40".into()));
+            ws.send(Message::Text("40{}".into())).await.unwrap();
+            assert!(matches!(ws.next().await.unwrap().unwrap(),Message::Text(_)));
+            assert!(matches!(ws.next().await.unwrap().unwrap(),Message::Binary(_)));
+
+            if attached {
+                let ack=json!(["success",{"payload":{"_placeholder":true,"num":0}}]);
+                ws.send(Message::Text(format!("461-11{ack}"))).await.unwrap();
+                ws.send(Message::Binary(vec![8,1])).await.unwrap();
+            } else {
+                ws.send(Message::Text("460-11[\"success\",{}]".into())).await.unwrap();
+            }
+            while ws.next().await.is_some() {}
+        });
+        let mut signal=Signal::connect(&[url],"synthetic-ticket",Duration::from_secs(2),false).await.unwrap();
+        let result=signal.control(json!({}),vec![8,1],Duration::from_secs(2)).await.unwrap();
+        assert_eq!(result,if attached {json!({"payload":"CAE="})} else {json!({})});
+        signal.close().await;
+        server.await.unwrap();
+    }
+}
