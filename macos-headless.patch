+/// Model a slow Socket.IO binary event while the caller's heartbeat repeatedly
+/// cancels event polling. Both completed attachments and the header must survive.
+#[tokio::test]
+async fn websocket_binary_event_survives_repeated_poll_cancellation() {
+    tokio::time::timeout(Duration::from_secs(5),async {
+        let listener=TcpListener::bind((std::net::Ipv4Addr::LOCALHOST,0)).await.unwrap();
+        let url=format!("ws://{}",listener.local_addr().unwrap());
+        let (stage_tx,mut stages)=mpsc::channel(2);
+        let (advance_tx,mut advance)=mpsc::channel(2);
+        let server=tokio::spawn(async move {
+            let (stream,_)=listener.accept().await.unwrap();
+            let mut ws=accept_async(stream).await.unwrap();
+            ws.send(Message::Text("0{}".into())).await.unwrap();
+            assert_eq!(ws.next().await.unwrap().unwrap(),Message::Text("40".into()));
+            ws.send(Message::Text("40{}".into())).await.unwrap();
+
+            let header=json!(["soac",{"data":{
+                "first":{"_placeholder":true,"num":0},
+                "second":{"_placeholder":true,"num":1}
+            }}]);
+            ws.send(Message::Text(format!("452-{header}"))).await.unwrap();
+            stage_tx.send(()).await.unwrap();
+            advance.recv().await.unwrap();
+            ws.send(Message::Binary(vec![1,2])).await.unwrap();
+            stage_tx.send(()).await.unwrap();
+            advance.recv().await.unwrap();
+
+            // Heartbeats at either protocol layer must still work while waiting
+            // for a later attachment; a blocked pong would close the room.
+            ws.send(Message::Text("2fixture".into())).await.unwrap();
+            assert_eq!(ws.next().await.unwrap().unwrap(),Message::Text("3fixture".into()));
+            ws.send(Message::Ping(vec![7])).await.unwrap();
+            assert_eq!(ws.next().await.unwrap().unwrap(),Message::Pong(vec![7]));
+            ws.send(Message::Binary(vec![4,0x1f,0x8b,8])).await.unwrap();
+            while ws.next().await.is_some() {}
+        });
+        let mut signal=Signal::connect(&[url],"synthetic-ticket",Duration::from_secs(2),false).await.unwrap();
+
+        // Interrupt after the header, then again after just one attachment.
+        // The old decoder loses the pending packet at the first interruption.
+        stages.recv().await.unwrap();
+        assert!(tokio::time::timeout(Duration::from_millis(20),signal.event()).await.is_err());
+        advance_tx.send(()).await.unwrap();
+        stages.recv().await.unwrap();
+        assert!(tokio::time::timeout(Duration::from_millis(20),signal.event()).await.is_err());
+        advance_tx.send(()).await.unwrap();
+
+        let event=signal.event().await.unwrap();
+        assert_eq!(event,json!(["soac",{"data":{"first":"AQI=","second":"H4sI"}}]));
+        signal.close().await;
+        server.await.unwrap();
+    }).await.expect("binary signaling cancellation regression timed out");
+}
