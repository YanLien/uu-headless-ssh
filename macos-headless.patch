 enum Packet { Ack(u64,Value), Event(Value) }
+
+/// A Socket.IO binary packet spans a JSON header and subsequent binary frames.
+/// Its contents stay private; diagnostics expose only the attachment count.
+struct BinaryPacket {
+    value:Value,
+
+    count:usize,
+
+    attachments:Vec<String>,
+
+    ack:Option<u64>,
+}
+
+impl BinaryPacket {
+    fn header(text:&str)->Result<Self,String> {
+        let dash=text.find('-').ok_or("Malformed binary signaling packet")?;
+        let count:usize=text[2..dash].parse().map_err(|_|"Malformed binary attachment count")?;
+        if count>8 {return Err("Too many signaling attachments".into())}
+        let begin=text.find('[').filter(|begin|*begin>dash).ok_or("Malformed binary signaling packet")?;
+        let value=serde_json::from_str(&text[begin..]).map_err(|_|"Malformed binary signaling body")?;
+        let ack=if text.starts_with("46") {
+            Some(text[dash+1..begin].parse().map_err(|_|"Malformed binary acknowledgement id")?)
+        } else {None};
+        Ok(Self{value,count,attachments:Vec::with_capacity(count),ack})
+    }
+
+    fn finish(mut self)->Packet {
+        fn fill(value:&mut Value,attachments:&[String]) {
+            match value {
+                Value::Object(object) if object.get("_placeholder")==Some(&Value::Bool(true))=> {
+                    if let Some(data)=object.get("num").and_then(Value::as_u64).and_then(|n|attachments.get(n as usize)) {
+                        *value=Value::String(data.clone());
+                    }
+                }
+                Value::Object(object)=>for value in object.values_mut(){fill(value,attachments)},
+                Value::Array(array)=>for value in array{fill(value,attachments)},
+                _=>{},
+            }
+        }
+        fill(&mut self.value,&self.attachments);
+        log::info!("Viewer binary signaling packet: attachments={} acknowledgement={}",self.count,self.ack.is_some());
+        match self.ack {Some(id)=>Packet::Ack(id,self.value),None=>Packet::Event(self.value)}
+    }
+}
