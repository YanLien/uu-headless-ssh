+        // id for response correlation and older hosts.
+        let payload=json!({"session_id":id}).to_string();
+        let b=self.request((KILL_RESP,id as u64),BINARY,encode(KILL_REQ,id,payload.as_bytes())).await?;
+        let response:Value=serde_json::from_slice(&b).map_err(|_|"Invalid terminal kill response")?;
+        if response["code"].as_i64()!=Some(0) {
+            let message=response.get("message").and_then(Value::as_str).unwrap_or("").chars().filter(|c|!c.is_control()).take(100).collect::<String>();
+            return Err(format!("Terminal kill rejected: code={:?} message={message}",response.get("code").and_then(Value::as_i64)))
+        }
+        Ok(())
     }
 }
 
