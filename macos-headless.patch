+/// Commit a queued frame only after the sink is ready. There is no await between
+/// dequeue and start_send; cancellation during flush leaves the frame in the sink.
+pub(super) async fn flush_outbox<S:Sink<Message>+Unpin>(socket:&mut S,outbox:&mut VecDeque<Message>)->Result<(),String> {
+    while !outbox.is_empty() {
+        futures_util::future::poll_fn(|context|Pin::new(&mut *socket).poll_ready(context))
+            .await.map_err(|_|"Signaling send failed")?;
+        let message=outbox.pop_front().unwrap();
+        Pin::new(&mut *socket).start_send(message).map_err(|_|"Signaling send failed")?;
+    }
+    socket.flush().await.map_err(|_|"Signaling send failed".into())
+}
