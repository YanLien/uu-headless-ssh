+/// Listing and terminating selected sessions must work without a TTY and never
+/// send OPEN; cleanup cannot itself allocate another remote PowerShell process.
+#[tokio::test]
+async fn terminal_management_never_opens_a_shell() {
+    for ids in [vec![],vec![37,41]] {
+        let (io,rx,input,mut out)=pair();
+        let expected=ids.clone();
+        let server=tokio::spawn(async move {
+            if expected.is_empty() {
+                let (channel,data)=out.recv().await.unwrap();
+                assert_eq!(channel,BINARY);
+                let frame=crate::terminal::decode(&data).unwrap();
+                assert_eq!(frame.kind,terminal::LIST_REQ);
+                input.send((BINARY,terminal::encode(terminal::LIST_RESP,frame.session,b"[]"))).await.unwrap();
+            } else {
+                let (channel,data)=out.recv().await.unwrap();
+                assert_eq!(channel,BINARY);
+                let list=crate::terminal::decode(&data).unwrap();
+                assert_eq!(list.kind,terminal::LIST_REQ);
+                let rows:Vec<_>=expected.iter().map(|id|serde_json::json!({"session_id":id})).collect();
+                input.send((BINARY,terminal::encode(terminal::LIST_RESP,list.session,serde_json::to_string(&rows).unwrap().as_bytes()))).await.unwrap();
+                for id in expected {
+                    let (channel,data)=out.recv().await.unwrap();
+                    assert_eq!(channel,BINARY);
+                    let frame=crate::terminal::decode(&data).unwrap();
+                    assert_eq!(frame.kind,terminal::KILL_REQ);
+                    assert_eq!(frame.session,id);
+                    input.send((BINARY,terminal::encode(terminal::KILL_RESP,id,br#"{"code":0}"#))).await.unwrap();
+                }
+            }
+            assert!(out.recv().await.is_none(),"management must not send OPEN or create another shell");
+        });
+        super::cli::terminal_manage(io,rx,&ids).await.unwrap();
+        server.await.unwrap();
+    }
+}
+
+/// Windows can acknowledge OPEN with id zero. Cleanup survives cancellation of
+/// the command future, identifies its one new id, and never kills the old id.
+#[tokio::test]
+async fn owned_terminal_cleanup_survives_command_cancellation() {
+    let (io,rx,input,mut out)=pair();
+    let (terminal,_events)=terminal::Terminal::new(io,rx);
+    let terminal=Arc::new(terminal);
+    let cleanup=lifecycle::Cleanup::default();
+    cleanup.track(terminal.clone(),false,&[serde_json::json!({"session_id":7})]);
+    let server=tokio::spawn(async move {
+        for _ in 0..2 {
+            let (_,data)=out.recv().await.unwrap();
+            let frame=crate::terminal::decode(&data).unwrap();
+            assert_eq!(frame.kind,terminal::LIST_REQ);
+            input.send((BINARY,terminal::encode(terminal::LIST_RESP,frame.session,br#"[{"session_id":7},{"session_id":9}]"#))).await.unwrap();
+        }
+        let (_,data)=out.recv().await.unwrap();
+        let frame=crate::terminal::decode(&data).unwrap();
+        assert_eq!(frame.kind,terminal::KILL_REQ);
+        assert_eq!(frame.session,9);
+        assert_eq!(serde_json::from_slice::<serde_json::Value>(&frame.payload).unwrap()["session_id"],9);
+        input.send((BINARY,terminal::encode(terminal::KILL_RESP,9,br#"{"code":0}"#))).await.unwrap();
+        assert!(out.recv().await.is_none());
+    });
+
+    let command_cleanup=cleanup.clone();
+    let command=async {
+        command_cleanup.opened(0);
+        command_cleanup.identify().await.unwrap();
+        std::future::pending::<()>().await;
+    };
+    assert!(tokio::time::timeout(Duration::from_millis(20),command).await.is_err());
+    assert_eq!(cleanup.owned(),Some(9));
+    cleanup.finish().await.unwrap();
+    assert_eq!(cleanup.owned(),None);
+    drop(terminal);
+    server.await.unwrap();
+}
