+/// A later inventory may leave just somebody else's new session after our
+/// shell has exited. Once the first snapshot is ambiguous or empty, cleanup
+/// must retain that uncertainty instead of deleting the later singleton.
+#[tokio::test]
+async fn uncertain_terminal_ownership_is_never_retried() {
+    for first in [
+        serde_json::json!([{"session_id":7},{"session_id":8},{"session_id":9}]),
+        serde_json::json!([{"session_id":7}]),
+    ] {
+        let (io,rx,input,mut out)=pair();
+        let (terminal,_events)=terminal::Terminal::new(io,rx);
+        let terminal=Arc::new(terminal);
+        let cleanup=lifecycle::Cleanup::default();
+        cleanup.track(terminal.clone(),false,&[serde_json::json!({"session_id":7})]);
+        cleanup.opened(0);
+        let server=tokio::spawn(async move {
+            let mut requests=Vec::new();
+            while let Some((_,data))=out.recv().await {
+                let frame=crate::terminal::decode(&data).unwrap();
+                requests.push(frame.kind);
+                let response=match frame.kind {
+                    terminal::LIST_REQ=> {
+                        let rows=if requests.len()==1 {first.clone()} else {serde_json::json!([{"session_id":7},{"session_id":9}])};
