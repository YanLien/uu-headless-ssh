+    /// Only a successful renewal with a valid key may defer the next request for
+    /// five minutes; stale replies and failure replies must retain retry timing.
+    #[tokio::test]
+    async fn refresh_schedule_retries_failures_and_rejects_stale_acknowledgements() {
+        let now=Instant::now();
+        let mut refresh=Refresh::new(now);
+        assert_eq!(refresh.next,now+Duration::from_secs(30));
+        refresh.request(11,now+Duration::from_secs(30));
+        assert_eq!(refresh.next,now+Duration::from_secs(60));
+        assert!(!refresh.acknowledge(99,&json!(["success",{"reconnect_key":"synthetic"}]),now));
+        assert!(refresh.acknowledge(11,&json!(["failure",{}]),now+Duration::from_secs(31)));
+        assert_eq!(refresh.next,now+Duration::from_secs(60));
+
+        refresh.request(12,now+Duration::from_secs(60));
+        refresh.request(13,now+Duration::from_secs(90));
+        assert!(refresh.acknowledge(13,&json!(["success",{"reconnect_key":"synthetic"}]),now+Duration::from_secs(91)));
+        let deadline=now+Duration::from_secs(391);
+        assert_eq!(refresh.next,deadline);
+        assert!(refresh.acknowledge(12,&json!(["success",{"reconnect_key":"older"}]),now+Duration::from_secs(92)));
+        assert_eq!(refresh.next,deadline);
+        assert_eq!(refresh.accepted,13);
+    }
