+    /// Cancel both before a write is accepted and after it is buffered. Retrying
+    /// must deliver each frame once and retain the order of pong and ICE data.
+    #[tokio::test]
+    async fn canceled_writes_keep_queued_and_buffered_frames() {
+        let expected=vec![Message::Text("3fixture".into()),Message::Text("42[\"soac\",{}]".into())];
+        let mut queue=VecDeque::from(expected.clone());
+        let mut sink=StalledSink{ready:false,flush_ready:false,accepted:Vec::new()};
+
+        assert!(tokio::time::timeout(Duration::from_millis(5),flush_outbox(&mut sink,&mut queue)).await.is_err());
+        assert_eq!(queue.len(),2);
+        assert!(sink.accepted.is_empty());
+        sink.ready=true;
+        assert!(tokio::time::timeout(Duration::from_millis(5),flush_outbox(&mut sink,&mut queue)).await.is_err());
+        assert!(queue.is_empty());
+        assert_eq!(sink.accepted,expected);
+
+        sink.flush_ready=true;
+        flush_outbox(&mut sink,&mut queue).await.unwrap();
+        assert_eq!(sink.accepted,expected,"a canceled flush must not enqueue a duplicate pong");
+    }
