+    /// A transport failure cancels client I/O, but its registry entry must still
+    /// let the outer connection scope confirm and delete that client's shell.
+    #[tokio::test]
+    async fn aborted_client_keeps_ownership_for_outer_cleanup() {
+        tokio::time::timeout(std::time::Duration::from_secs(2), async {
+            let fixture = ScopedFixture::new(false);
+            let (_client, task, ready) = fixture.open(None).await;
+            let Message::ReadyScoped {
+                owned: Some(id), ..
+            } = ready
+            else {
+                panic!("missing ownership")
+            };
+            task.abort();
+            assert!(task.await.unwrap_err().is_cancelled());
+            for entry in fixture.registry.entries() {
+                entry.finish().await.unwrap();
+            }
+            assert!(!fixture.remote.lock().unwrap().contains(&id));
+            assert!(fixture.remote.lock().unwrap().contains(&7));
+        })
+        .await
+        .unwrap();
+    }
+
+    /// Ping, list and explicit termination are management operations; none may
+    /// allocate a shell while a terminal is already using the shared transport.
+    #[tokio::test]
+    async fn shared_management_does_not_open_a_terminal() {
+        tokio::time::timeout(std::time::Duration::from_secs(2),async {
+            use super::super::terminal as term;
+            let fixture=ScopedFixture::new(false);
+            for message in [Message::Ping,Message::List,Message::Kill(vec![7,99])] {
+                let(mut client,socket)=tokio::io::duplex(4096);
+                let(t,opening,active,events,registry)=(fixture.terminal.clone(),fixture.opening.clone(),fixture.active.clone(),fixture.output.subscribe(),fixture.registry.clone());
+                let task=tokio::spawn(serve(socket,t,opening,active,events,Some(registry)));
+                write(&mut client,&message).await.unwrap();
+                match message {
+                    Message::Ping=>assert!(matches!(read(&mut client).await,Ok(Message::Pong(1)))),
+                    Message::List=>assert!(matches!(read(&mut client).await,Ok(Message::Sessions(rows))if rows.len()==1)),
+                    Message::Kill(_)=>assert!(matches!(read(&mut client).await,Ok(Message::Killed(ids))if ids==[7,99])),
+                    _=>unreachable!(),
+                }
+                task.await.unwrap().unwrap();
+            }
+            assert!(!fixture.trace.lock().unwrap().iter().any(|(kind,_)|*kind==term::OPEN));
+            assert!(fixture.remote.lock().unwrap().is_empty());
+        }).await.unwrap();
+    }
+
+    /// Short private socket paths keep these kernel IPC tests portable to macOS.
+    struct SocketDirectory(PathBuf);
+
+    impl SocketDirectory {
+        fn new() -> Self {
+            use std::os::unix::fs::DirBuilderExt;
+            let base = if cfg!(target_os = "macos") {
+                PathBuf::from("/private/tmp")
+            } else {
+                std::env::temp_dir()
+            };
+            let path = base.join(format!("uu-ipc-test-{}", super::super::super::wire::uuid()));
+            std::fs::DirBuilder::new()
+                .mode(0o700)
+                .create(&path)
+                .unwrap();
+            Self(path)
+        }
+    }
+
+    impl Drop for SocketDirectory {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_dir_all(&self.0);
+        }
+    }
+
+    /// An active attachment keeps the broker alive. Removing the last client
+    /// starts the idle deadline and releases its socket without ending old work.
+    #[tokio::test]
+    async fn broker_waits_for_active_clients_then_stops_when_idle() {
+        tokio::time::timeout(std::time::Duration::from_secs(2), async {
+            let directory = SocketDirectory::new();
+            let path = directory.0.join("tty");
+            let server = Server::at(&path).unwrap();
+            let fixture = ScopedFixture::new(false);
+            let task = tokio::spawn(server.run_headless_idle(
+                fixture.terminal.clone(),
+                fixture.output.clone(),
+                fixture.registry.clone(),
+                std::time::Duration::from_millis(30),
+            ));
+            let mut client = UnixStream::connect(&path).await.unwrap();
+            write(
+                &mut client,
+                &Message::Open {
+                    session: None,
+                    cols: 80,
+                    rows: 24,
+                },
+            )
+            .await
+            .unwrap();
+            assert!(matches!(
+                read(&mut client).await,
+                Ok(Message::ReadyScoped { owned: Some(_), .. })
+            ));
+
+            tokio::time::sleep(std::time::Duration::from_millis(80)).await;
+            assert!(
+                !task.is_finished(),
+                "an active client must prevent idle shutdown"
+            );
+            write(&mut client, &Message::Close).await.unwrap();
+            assert!(matches!(read(&mut client).await, Ok(Message::Closed)));
+            task.await.unwrap().unwrap();
+
+            assert!(
+                !path.exists(),
+                "idle shutdown must remove the listening socket"
+            );
+            assert_eq!(
+                *fixture.remote.lock().unwrap(),
+                std::collections::BTreeSet::from([7])
+            );
+        })
+        .await
+        .unwrap();
+    }
+
+    /// Never overwrite user files or bind a terminal socket in a directory that
+    /// another account can enter; failed validation must leave paths unchanged.
+    #[tokio::test]
+    async fn broker_socket_rejects_unsafe_paths_without_modifying_them() {
+        use std::os::unix::fs::{symlink, PermissionsExt};
+        let directory = SocketDirectory::new();
+        let path = directory.0.join("tty");
+        std::fs::write(&path, b"synthetic user file").unwrap();
+        assert!(Server::at(&path).is_err());
+        assert_eq!(std::fs::read(&path).unwrap(), b"synthetic user file");
+        std::fs::remove_file(&path).unwrap();
+
+        std::fs::set_permissions(&directory.0, std::fs::Permissions::from_mode(0o755)).unwrap();
+        assert!(Server::at(&path).is_err());
+        assert!(!path.exists());
+        std::fs::set_permissions(&directory.0, std::fs::Permissions::from_mode(0o700)).unwrap();
+        let link = directory.0.join("link");
+        symlink(&directory.0, &link).unwrap();
+        assert!(Server::at(&link.join("tty")).is_err());
+        assert!(std::fs::symlink_metadata(&link)
+            .unwrap()
+            .file_type()
+            .is_symlink());
     }
 }
