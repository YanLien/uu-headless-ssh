+/// Keep reads cancellable when the remote session exits. macOS does not let
+/// kqueue watch the synthetic /dev/tty descriptor, so poll nonblocking reads
+/// without creating a blocking stdin task that could hold runtime shutdown.
+async fn read_tty(input: &mut std::fs::File, buffer: &mut [u8]) -> std::io::Result<usize> {
+    loop {
+        match std::io::Read::read(input, buffer) {
+            Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                tokio::time::sleep(std::time::Duration::from_millis(15)).await;
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+            result => return result,
+        }
+    }
+}
