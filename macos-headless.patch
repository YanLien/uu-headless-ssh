+/// Keep existing terminal commands compatible while routing all normal use
+/// through one per-device broker. Direct cloud connections require an explicit
+/// diagnostic opt-in because another Socket.IO connection can evict a live one.
+fn terminal_launcher(args:&[String])->Option<std::process::Command> {
+    let mode=args.first()?.as_str();
+    let mut options=Vec::new();
+    match mode {
+        "terminal" if args.len()==2=>{},
+        "terminal" if args.len()==3 && args[2].parse::<u32>().is_ok_and(|id|id!=0)=>options.extend(["--session".to_owned(),args[2].clone()]),
+        "terminal-list" if args.len()==2=>options.push("--list".to_owned()),
+        "terminal-kill" if args.len()>=3 && args[2..].iter().all(|value|value.parse::<u32>().is_ok_and(|id|id!=0))=>{
+            options.push("--kill".to_owned());options.extend_from_slice(&args[2..]);
+        },
+        _=>return None,
+    }
+    let executable=std::env::current_exe().ok()?;
+    let script=executable.parent()?.parent()?.join("scripts/terminal.py");
+    let mut command=std::process::Command::new("/usr/bin/python3");
+    command.arg(script).args(["--device",&args[1]]).args(options);
+    Some(command)
+}
