+/// Room renewal follows the official native session's schedule. Only ack ids
+/// and deadlines are retained; the returned reconnect credential is never stored.
+struct Refresh {
+    next:Instant,
+
+    pending:VecDeque<u64>,
+
+    accepted:u64,
+}
+
+impl Refresh {
+    fn new(now:Instant)->Self {
+        Self{next:now+Duration::from_secs(30),pending:VecDeque::new(),accepted:0}
+    }
+
+    fn request(&mut self,id:u64,now:Instant) {
+        self.pending.push_back(id);
+        if self.pending.len()>16 {self.pending.pop_front();}
+        self.next=now+Duration::from_secs(30);
+    }
+
+    fn acknowledge(&mut self,id:u64,value:&Value,now:Instant)->bool {
+        if !self.pending.contains(&id){return false}
+        self.pending.retain(|pending|*pending!=id);
+        let valid=value.as_array().is_some_and(|ack| {
+            ack.first().and_then(Value::as_str)==Some("success") && ack.get(1).and_then(|body|body.get("reconnect_key"))
+                .and_then(Value::as_str).is_some_and(|key|!key.is_empty() && key.len()<=16384)
+        });
+        if valid && id>self.accepted {
+            self.accepted=id;
+            self.next=now+Duration::from_secs(300);
+        }
+        true
+    }
+}
