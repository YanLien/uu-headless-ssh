+/// A headless broker owns one cloud connection; local clients exchange terminal
+/// frames only. Ownership remains in the outer registry if transport polling ends.
+pub async fn headless(
+    io: super::Transport,
+    rx: mpsc::Receiver<super::Packet>,
+    path: &Path,
+    registry: lifecycle::Registry,
+) -> Result<(), String> {
+    let (t, mut events) = Terminal::new(io, rx);
+    let t = Arc::new(t);
+    t.check_env().await?;
+    let server = Server::at(path)?;
+    let (output, _) = broadcast::channel(256);
+    let sender = output.clone();
+    let mut relay = super::Abort(tokio::spawn(async move {
+        while let Some(event) = events.recv().await {
+            let _ = sender.send(event);
+        }
+    }));
+    tokio::select! {
+        result=server.run_headless(t,output,registry)=>result,
+        _=&mut relay.0=>Err("Shared UU terminal transport ended".into()),
+    }
 }
 
