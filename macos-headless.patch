+    /// Replace sink readiness and flushing with explicit stalls. Accepted frames
+    /// are real ordered writes to this fixture, without network/socket timing.
+    struct StalledSink {
+        ready:bool,
+
+        flush_ready:bool,
+
+        accepted:Vec<Message>,
+    }
+
+    impl Sink<Message> for StalledSink {
+        type Error=();
+
+        fn poll_ready(self:Pin<&mut Self>,_:&mut Context<'_>)->Poll<Result<(),()>> {
+            if self.ready {Poll::Ready(Ok(()))} else {Poll::Pending}
+        }
+
+        fn start_send(mut self:Pin<&mut Self>,message:Message)->Result<(),()> {
+            self.accepted.push(message);Ok(())
+        }
+
+        fn poll_flush(self:Pin<&mut Self>,_:&mut Context<'_>)->Poll<Result<(),()>> {
+            if self.flush_ready {Poll::Ready(Ok(()))} else {Poll::Pending}
+        }
+
+        fn poll_close(self:Pin<&mut Self>,_:&mut Context<'_>)->Poll<Result<(),()>> {
+            Poll::Ready(Ok(()))
